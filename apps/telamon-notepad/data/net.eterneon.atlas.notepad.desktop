[Desktop Entry]
# The name Notepad had before Telamon Notepad (net.eterneon.telamon.notepad):
# a hidden alias, for this release, so what still names it keeps opening
# Notepad (default-application lists, panel launchers, "open with" history).
Type=Application
Name=Notepad
NoDisplay=true
Exec=telamon-notepad %U
Icon=net.eterneon.telamon.notepad
Terminal=false
Categories=Qt;KDE;Utility;TextEditor;
MimeType=text/plain;text/markdown;
StartupNotify=true
X-KDE-StartupNotify=true
StartupWMClass=net.eterneon.telamon.notepad
