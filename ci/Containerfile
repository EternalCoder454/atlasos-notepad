# The CI build image (ghcr.io/eternalcoder454/atlas-notepad-dev), built by the
# `publish` job of .github/workflows/ci.yml from the repo root, on main only.
# Context: framework-rpms/ holds atlas-ui and atlas-symbols-fonts, built from
# atlas-framework at the rev Cargo.toml pins. ci/install-deps.sh does the work
# (packages, Atlas.Ui, the spec's build dependencies) and leaves the RPMs in
# /opt/atlas-rpms for packaging/build-rpm.sh. Nothing secret goes in: the
# inputs are bind-mounted for the one RUN, so they add no layer.
FROM registry.fedoraproject.org/fedora:44

LABEL org.opencontainers.image.source="https://github.com/EternalCoder454/atlasos-notepad" \
      org.opencontainers.image.description="Build image for CI of Atlas Notepad: Fedora 44, Qt 6, Kirigami, Atlas.Ui" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0"

RUN --mount=type=bind,source=ci,target=/src/ci \
    --mount=type=bind,source=packaging,target=/src/packaging \
    --mount=type=bind,source=framework-rpms,target=/src/framework-rpms \
    bash /src/ci/install-deps.sh /src/framework-rpms && dnf clean all
